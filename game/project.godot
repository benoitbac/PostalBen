; PostalBen — Godot 4 project configuration
; Engine: Godot 4.7.1 (.NET / C#)

config_version=5

[application]

config/name="PostalBen"
config/description="An open-world sandbox where the errands are mundane and the world is not."
config/version="0.1.0"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[dotnet]

project/assembly_name="PostalBen"

[autoload]

Locale="*res://scripts/systems/LocaleManager.cs"
AudioDirector="*res://scripts/audio/AudioDirector.cs"
VoiceBank="*res://scripts/audio/VoiceBank.cs"
Subtitles="*res://scripts/ui/SubtitleLayer.cs"
GameState="*res://scripts/systems/GameState.cs"
Notoriety="*res://scripts/systems/NotorietySystem.cs"
ErrandLog="*res://scripts/systems/ErrandLog.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://localization/ui.en.translation", "res://localization/ui.fr.translation", "res://localization/vo.en.translation", "res://localization/vo.fr.translation")
locale/fallback="en"
locale/test=""

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"pressed":false),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"pressed":false),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"pressed":false),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"pressed":false),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"pressed":false),Object(InputEventJoypadButton,"button_index":0,"pressed":false)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325,"pressed":false),Object(InputEventJoypadButton,"button_index":8,"pressed":false)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67,"pressed":false),Object(InputEventJoypadButton,"button_index":9,"pressed":false)]
}
attack_primary={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":false),Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}
attack_secondary={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":false),Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69,"pressed":false),Object(InputEventJoypadButton,"button_index":2,"pressed":false)]
}
holster={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":88,"pressed":false),Object(InputEventJoypadButton,"button_index":3,"pressed":false)]
}
taunt={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":84,"pressed":false),Object(InputEventJoypadButton,"button_index":13,"pressed":false)]
}
weapon_next={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":5,"pressed":false)]
}
weapon_prev={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":4,"pressed":false)]
}
errand_log={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74,"pressed":false),Object(InputEventJoypadButton,"button_index":5,"pressed":false)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305,"pressed":false),Object(InputEventJoypadButton,"button_index":6,"pressed":false)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="police"
3d_physics/layer_5="projectile"
3d_physics/layer_6="interactable"
3d_physics/layer_7="trigger"
3d_physics/layer_8="ragdoll"

[physics]

3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.42, 0.45, 0.38, 1)

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"
